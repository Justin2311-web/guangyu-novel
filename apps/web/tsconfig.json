{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@guangyu/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@guangyu/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@guangyu/database": [
        "../../packages/database/src/index.ts"
      ],
      "@guangyu/database/*": [
        "../../packages/database/src/*"
      ],
      "@guangyu/config": [
        "../../packages/config/src/index.ts"
      ],
      "@guangyu/config/*": [
        "../../packages/config/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
